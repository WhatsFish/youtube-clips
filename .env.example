# Copy to .env and fill in. Real values live in ~/.config/youtube-clips.env;
# this file (and .env) is gitignored. Bootstrap script reads the ~/.config
# version directly; the docker container reads ./.env via env_file.

PG_PASSWORD=

# Optional: enable Umami pageview analytics. Both required to render the
# tracking script; either missing → skipped silently.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
